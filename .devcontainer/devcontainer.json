{
  "name": "dev-features",
  "image": "fedora:latest",
  "runArgs": [
    "--network=host"
  ],
  "mounts": [
    "source=${localWorkspaceFolder}/.opencode/share,target=/home/dev/.local/share/opencode,type=bind",
    "source=${localWorkspaceFolder}/.opencode/cache,target=/home/dev/.cache/opencode,type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "username": "dev",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/r00sta/dev-features/base:1.0.8": {
      "helixVersion": "25.07.1"
    },
    "ghcr.io/r00sta/dev-features/python:1.0.1": {}
  },
  "remoteUser": "dev",
  "containerUser": "dev"
}